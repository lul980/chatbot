# Copia este archivo como .env y ajusta si hace falta.

# true = usa la IA local para entender mensajes libres y detectar riesgo. false = solo menú y palabras clave.
OLLAMA_ACTIVO=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Si la IA tarda más que esto (en milisegundos), el bot contesta con el menú.
OLLAMA_TIMEOUT_MS=12000

# Milisegundos que el bot espera por si el estudiante manda varios mensajes seguidos (se contestan juntos).
ESPERA_MENSAJES_MS=1500

# Privacidad: false = los logs NO guardan el número ni el texto de los estudiantes.
# Ponlo en true solo para pruebas con números del equipo.
LOG_MENSAJES=false

# Enlace de Google Maps del Wellness Center / Bienestar Estudiantil (PENDIENTE).
# La foto va en assets/lugares/wellness-center.jpg
# WELLNESS_MAPS_URL=https://maps.app.goo.gl/...

# Opcional: navegador para WhatsApp Web. Si no se pone, busca Chrome o Edge instalados.
# CHROME_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Opcional: número del bot con lada (México: 521 + 10 dígitos). Si se pone, en vez del QR
# aparece un código de 8 letras para "Vincular con el número de teléfono".
# NUMERO_BOT=5218112345678

# Opcional: carpeta donde se guarda la sesión de WhatsApp (default: ~/.botiquin-bot).
# Debe ser una ruta corta: en Windows una ruta larga hace que WhatsApp Web truene.
# SESION_PATH=C:\botiquin-sesion
